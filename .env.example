# Server HTTP port
TALOS_SERVER_PORT=8080
# Bind to 0.0.0.0 only for an explicitly trusted LAN deployment.
TALOS_SERVER_BIND_ADDRESS=127.0.0.1

# PostgreSQL container. Replace the placeholder password locally before use.
POSTGRES_USER=talos
POSTGRES_PASSWORD=change-me-before-running
POSTGRES_DB=talos

# Server containers reach PostgreSQL through its Compose service name.
TALOS_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?sslmode=disable
TALOS_DB_MAX_OPEN_CONNS=10
TALOS_DB_MAX_IDLE_CONNS=5
TALOS_DB_CONN_MAX_LIFETIME=30m
TALOS_DB_CONN_MAX_IDLE_TIME=5m
TALOS_DB_PING_TIMEOUT=5s

# The Compose server image fixes TALOS_DATA_DIR at /var/lib/talos, backed by a
# named volume.
TALOS_DATA_DIR=/var/lib/talos

# HTTP without TLS is allowed only when this deployment is explicitly trusted.
TALOS_TRUSTED_LAN=false

# Maximum accepted upload size in bytes (default: 100 MiB)
TALOS_UPLOAD_MAX_BYTES=104857600

# Presentation defaults; persisted timestamps remain UTC.
TALOS_DEFAULT_LOCALE=pt-BR
TALOS_DEFAULT_CURRENCY=BRL
TALOS_DEFAULT_TIMEZONE=America/Sao_Paulo
